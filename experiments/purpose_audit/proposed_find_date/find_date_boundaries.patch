+@lru_cache(maxsize=2048)
+def _variant_pattern(target: date) -> "re.Pattern[str]":
+    """One compiled alternation of every rendering of `target`, each bounded so a LONGER number cannot satisfy a
+    shorter one. Found 2026-10-02: the old bare substring test accepted "2 october 2026" inside "12 october 2026", so a
+    claim of 2026-10-02 was "found" on a page that only says 12 October (5 of 5 sampled real pages, e.g. Black Hat's
+    call page). A date is not that date if a digit is glued to either side. Digits only, not letters: an ISO timestamp
+    (2026-10-12T23:59:00Z) legitimately has a letter after the day."""
+    alts = sorted({re.escape(v) for v in date_variants(target)}, key=len, reverse=True)
+    return re.compile(r"(?<![0-9])(?:" + "|".join(alts) + r")(?![0-9])")
